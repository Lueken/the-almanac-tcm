[
	// FAR N-fixation (RULED 2026-08-22, reality baseline): the seven Fabaceae get the capped
	// AlmanacNitrogenFixing crop behavior. Relative magnitudes follow the baseline: fava tops
	// the annual pulses, alfalfa the perennials, soybean fixes least because its seed removes
	// more N than the plant banks (the net-sink flag). The cap is the behavior's own — the
	// engine's ConsumeNutrients floors at zero with no ceiling, so fixation without a cap
	// would be a soil pump. DAR and bdcrop entries are dependsOn-gated: inert until that mod
	// is in the pack (adoption lands with the 0.5 deploy).
	{
		"op": "addmerge",
		"path": "/cropProps/behaviors",
		"value": [ { "name": "AlmanacNitrogenFixing", "properties": { "fixPerStage": 0.4, "nCap": 55 } } ],
		"file": "game:blocktypes/plant/crop/soybean.json"
	},
	{
		"op": "addmerge",
		"path": "/cropProps/behaviors",
		"value": [ { "name": "AlmanacNitrogenFixing", "properties": { "fixPerStage": 1.0, "nCap": 65 } } ],
		"file": "game:blocktypes/plant/crop/peanut.json"
	},
