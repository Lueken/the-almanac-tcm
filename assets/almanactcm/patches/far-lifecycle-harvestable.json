[
	// FAR lifecycle: cut-and-come-again as pure data (RULED 2026-08-22, engine-verified).
	// Vanilla BlockBehaviorHarvestable with harvestedBlockCode reverts the crop to a mid
	// growth stage on a right-click pick; regrowth rides the normal farmland timer, which
	// keeps polling while a crop sits ripe (BEFarmland.cs:85-90). Breaking the plant remains
	// the full, final harvest with vanilla's own bigger drops — the standing trade is keep
	// picking small, or pull the plant. behaviorsByType REPLACES the plain behaviors list for
	// the matched variant, so Unstable is restated in every entry. The picked stage sits one
	// below each crop's seed-bolt stage, matching DAR's own herb-then-seed staging. All
	// entries are dependsOn-gated (adoption lands with the 0.5 deploy). Horseradish is
	// deliberately absent: a perennial ROOT is dug, not picked, and its lifecycle waits on a
	// design that respects that. Baseline set: chives, lettuce (leaf), eruca, estragon,
	// cucumber, tomato, alfalfa.
	{
		"op": "addmerge",
		"path": "/behaviorsByType",
		"value": {
			"*-6": [
				{ "name": "Unstable" },
				{ "name": "Harvestable", "properties": {
					"harvestTime": 0.6,
					"harvestedStacks": [ { "type": "item", "code": "deartibusrusticis:herb-chives", "quantity": { "avg": 1.5, "var": 1 } } ],
					"harvestedBlockCode": "deartibusrusticis:crop-chives-4"
				} }
			]
		},
		"file": "deartibusrusticis:blocktypes/plant/crop/chives.json",
		"dependsOn": [ { "modid": "deartibusrusticis" } ]
	},
	{
		"op": "addmerge",
