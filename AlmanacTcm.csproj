<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The machine-level VINTAGE_STORY value carries literal quotes; strip them. -->
    <VsDir>$(VINTAGE_STORY.Trim('"'))</VsDir>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\almanactcm</OutputPath>
    <Nullable>enable</Nullable>
    <AssemblyName>AlmanacTcm</AssemblyName>
    <RootNamespace>AlmanacTcm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VsDir)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VsDir)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VsDir)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VsDir)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VsDir)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VsDir)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="cairo-sharp">
      <HintPath>$(VsDir)/Lib/cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Sibling Almanac mod: hard dependency (modinfo), so the assembly is always
         loaded at runtime. PINNED TO THE RELEASED DLL, NOT THE SIBLING DEBUG OUTPUT
         (0.5.16 crash, 2026-10-09): Illuminated f6a5ef6 turned FontRegistry.SerifBody
         and SerifDecorative from `const` into properties. A const is INLINED into the
         caller, so building against a newer Debug DLL silently emits get_SerifBody /
         get_SerifDecorative calls that the DLL players actually run has no methods for,
         and the Callings tab died with MissingMethodException the moment it was opened.
         Both builds were labelled 0.3.1, so nothing looked wrong. Re-pin this file only
         when a matching Illuminated is genuinely deployed.

         RE-PINNED TO 0.3.3 on 2026-10-17. First to 0.3.2 for DecisionPanelComponent (the Great
         Work panel), then to 0.3.3 when 0.3.2 was withdrawn for shipping the Spotted Page seam
         by accident. That type does not exist before 0.3.2, so TCM 0.6.0 and Illuminated 0.3.3
         MUST ship as a pair - MinIlluminatedVersion was raised to 0.3.2 in the same change so a mismatched
         install is refused at boot with a readable message instead of dying when the Callings
         tab is first opened, which is how the 0.5.16 crash presented. -->
    <Reference Include="AlmanacIlluminated">
      <HintPath>lib\AlmanacIlluminated-0.3.3-released.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
